{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "cc-agents"
              }
            }
          ]
        },
        {
          "id": "usage",
          "type": "block",
          "size": {
            "px": 150
          },
          "content": {
            "mod": "cc-usage"
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "cc-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "center",
              "type": "stack",
              "active": "main",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 10,
                      "background": "background",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "height": 30,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                },
                {
                  "id": "board",
                  "type": "block",
                  "content": {
                    "mod": "cc-board"
                  }
                }
              ]
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": false,
              "size": {
                "px": 392
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "inbox",
                  "children": [
                    {
                      "id": "asks",
                      "type": "block",
                      "content": {
                        "mod": "cc-asks"
                      }
                    },
                    {
                      "id": "inbox",
                      "type": "block",
                      "content": {
                        "mod": "cc-inbox"
                      }
                    },
                    {
                      "id": "linear",
                      "type": "block",
                      "content": {
                        "mod": "cc-linear"
                      }
                    },
                    {
                      "id": "tasks",
                      "type": "block",
                      "content": {
                        "mod": "cc-tasks"
                      }
                    },
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "cc-status"
          }
        }
      ]
    }
  ],
  "preview": "layouts/command-center.svg"
}
